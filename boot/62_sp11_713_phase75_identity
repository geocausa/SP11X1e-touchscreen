#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
exec tail -n +4 $0
# Phase 75 is a mechanically renamed Phase 73 DMA build. The unique module,
# driver, parameter, and DT-compatible identities prevent the legacy FIFO and
# production DMA clients from masquerading as one another. Phase 73 and the
# 7.1.3 FIFO baseline remain untouched.

menuentry 'Ubuntu SP11 7.1.3 DMA Baseline (Phase 75)' --id 'sp11-phase75-identity' --class ubuntu --class gnu-linux --class gnu --class os {
        load_video
        set gfxpayload=keep
        insmod gzio
        insmod part_gpt
        insmod ext2
        insmod fdt
        search --no-floppy --fs-uuid --set=root 33e842b7-0434-4749-b03a-299bdcdb8b9f
        devicetree /boot/sp11-7.1.3-phase75-identity/x1e80100-microsoft-denali-sp11-phase75.dtb
        linux /boot/sp11-7.1.3-phase75-identity/vmlinuz-7.1.3-sp11-baseline1+ root=UUID=33e842b7-0434-4749-b03a-299bdcdb8b9f ro clk_ignore_unused pd_ignore_unused cma=128M efi=noruntime quiet splash console=tty0 crashkernel=2G-4G:320M,4G-32G:512M,32G-64G:1024M,64G-128G:2048M,128G-:4096M sp11_entry=7.1.3-phase75-identity mshw0485_touch.mode_config_fix=1
        initrd /boot/sp11-7.1.3-phase75-identity/initrd.img-7.1.3-sp11-baseline1+-phase75
}
