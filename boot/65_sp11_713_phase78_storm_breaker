#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
exec tail -n +4 $0
# Phase 78 adds a bounded reset-storm circuit breaker to Phase 77. Isolated
# resets still use gated software re-enumeration; three resets no more than
# five seconds apart force the existing full hardware power/reset path.

menuentry 'Ubuntu SP11 7.1.3 DMA Reset Storm Breaker (Phase 78)' --id 'sp11-phase78-storm-breaker' --class ubuntu --class gnu-linux --class gnu --class os {
        load_video
        set gfxpayload=keep
        insmod gzio
        insmod part_gpt
        insmod ext2
        insmod fdt
        search --no-floppy --fs-uuid --set=root 33e842b7-0434-4749-b03a-299bdcdb8b9f
        devicetree /boot/sp11-7.1.3-phase78-storm-breaker/x1e80100-microsoft-denali-sp11-phase75.dtb
        linux /boot/sp11-7.1.3-phase78-storm-breaker/vmlinuz-7.1.3-sp11-baseline1+ root=UUID=33e842b7-0434-4749-b03a-299bdcdb8b9f ro clk_ignore_unused pd_ignore_unused cma=128M efi=noruntime quiet splash console=tty0 crashkernel=2G-4G:320M,4G-32G:512M,32G-64G:1024M,64G-128G:2048M,128G-:4096M sp11_entry=7.1.3-phase78-storm-breaker mshw0485_touch.mode_config_fix=1 mshw0485_touch.behavior_v2=1 mshw0485_touch.reset_recovery_v2=1 mshw0485_touch.reset_storm_breaker=1
        initrd /boot/sp11-7.1.3-phase78-storm-breaker/initrd.img-7.1.3-sp11-baseline1+-phase78
}
