#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
exec tail -n +4 $0
# Isolated Phase 72 live-KDNET mode-config fix experiment. Phase 68, Phase 70,
# Phase 71, and the saved 7.1.3 baseline remain untouched. This entry enables
# g6ts_biosref.mode_config_fix=1 (echo GET_FEATURE 0x70 config into the
# SET_FEATURE 0x70 write and emit the OUTPUT_REPORT 0x09 mode report) and leaves
# windows_orchestrator=0 so the mode-config fix is the only changed variable.

menuentry 'Ubuntu SP11 7.1.1 Touch Phase 72 Mode-Config Fix' --id 'sp11-phase72' --class ubuntu --class gnu-linux --class gnu --class os {
        load_video
        set gfxpayload=keep
        insmod gzio
        insmod part_gpt
        insmod ext2
        insmod fdt
        search --no-floppy --fs-uuid --set=root 33e842b7-0434-4749-b03a-299bdcdb8b9f
        devicetree /boot/sp11-7.1.1-phase72/sp11-7.1.1-phase72-hybrid.dtb
        linux /boot/sp11-7.1.1-phase72/vmlinuz-7.1.1-sp11-gpicmp1+ root=UUID=33e842b7-0434-4749-b03a-299bdcdb8b9f ro clk_ignore_unused pd_ignore_unused cma=128M efi=noruntime quiet splash console=tty0 crashkernel=2G-4G:320M,4G-32G:512M,32G-64G:1024M,64G-128G:2048M,128G-:4096M sp11_entry=7.1.1-phase72 g6ts_biosref.mode_config_fix=1
        initrd /boot/sp11-7.1.1-phase72/initrd.img-7.1.1-sp11-gpicmp1+-phase72
}
