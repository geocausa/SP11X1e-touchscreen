#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
exec tail -n +4 $0
# Stock/FIFO rollback for the 7.1.3 SP11 baseline. Production touch uses the
# separately isolated Phase 75 DMA entry.

menuentry 'Ubuntu SP11 7.1.3 FIFO Fallback (Touch+Audio+WiFi+BT+GPU)' --id 'sp11-baseline-fifo' --class ubuntu --class gnu-linux --class gnu --class os {
	load_video
	set gfxpayload=keep
	insmod gzio
	insmod part_gpt
	insmod ext2
	insmod fdt
	search --no-floppy --fs-uuid --set=root 33e842b7-0434-4749-b03a-299bdcdb8b9f
	devicetree /boot/sp11-7.1.3-baseline1/x1e80100-microsoft-denali-sp11-baseline1.dtb
	linux /boot/sp11-7.1.3-baseline1/vmlinuz-7.1.3-sp11-baseline1+ root=UUID=33e842b7-0434-4749-b03a-299bdcdb8b9f ro clk_ignore_unused pd_ignore_unused cma=128M efi=noruntime quiet splash console=tty0 crashkernel=2G-4G:320M,4G-32G:512M,32G-64G:1024M,64G-128G:2048M,128G-:4096M sp11_entry=7.1.3-baseline1
	initrd /boot/sp11-7.1.3-baseline1/initrd.img-7.1.3-sp11-baseline1+
}
