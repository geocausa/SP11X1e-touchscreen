#!/bin/sh
# SPDX-License-Identifier: GPL-2.0

PREREQ=""

prereqs()
{
	echo "$PREREQ"
}

case "$1" in
prereqs)
	prereqs
	exit 0
	;;
esac

. /usr/share/initramfs-tools/hook-functions

# The experimental client has no stock Ubuntu initramfs policy entry.  Embed
# the exact module staged under /lib/modules for the target image.
manual_add_modules g6ts_biosref
