diff --git a/include/trace/events/qcom_gpi.h b/include/trace/events/qcom_gpi.h
new file mode 100644
index 000000000..07c720892
--- /dev/null
+++ b/include/trace/events/qcom_gpi.h
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#undef TRACE_SYSTEM
+#define TRACE_SYSTEM qcom_gpi
+
+#if !defined(_TRACE_QCOM_GPI_H) || defined(TRACE_HEADER_MULTI_READ)
+#define _TRACE_QCOM_GPI_H
+
+#include <linux/tracepoint.h>
+
+TRACE_EVENT(gpi_event,
+	    TP_PROTO(u32 instance, u32 offset, u64 producer, const u32 *words),
+	    TP_ARGS(instance, offset, producer, words),
+
+	    TP_STRUCT__entry(__field(u32, instance)
+			     __field(u32, offset)
+			     __field(u64, producer)
+			     __array(u32, words, 4)
+	    ),
+
+	    TP_fast_assign(__entry->instance = instance;
+			   __entry->offset = offset;
+			   __entry->producer = producer;
+			   memcpy(__entry->words, words, sizeof(__entry->words));
+	    ),
+
+	    TP_printk("instance=%u offset=%u producer=%#llx event=%08x:%08x:%08x:%08x",
+		      __entry->instance, __entry->offset, __entry->producer,
+		      __entry->words[0], __entry->words[1],
+		      __entry->words[2], __entry->words[3])
+);
+
+TRACE_EVENT(gpi_submit,
+	    TP_PROTO(u32 instance, u32 channel, int cookie, u64 base,
+		     u64 doorbell, u32 length),
+	    TP_ARGS(instance, channel, cookie, base, doorbell, length),
+
+	    TP_STRUCT__entry(__field(u32, instance)
+			     __field(u32, channel)
+			     __field(int, cookie)
+			     __field(u64, base)
+			     __field(u64, doorbell)
+			     __field(u32, length)
+	    ),
+
+	    TP_fast_assign(__entry->instance = instance;
+			   __entry->channel = channel;
+			   __entry->cookie = cookie;
+			   __entry->base = base;
+			   __entry->doorbell = doorbell;
+			   __entry->length = length;
+	    ),
+
+	    TP_printk("instance=%u channel=%u cookie=%d base=%#llx doorbell=%#llx length=%u",
+		      __entry->instance, __entry->channel, __entry->cookie,
+		      __entry->base, __entry->doorbell, __entry->length)
+);
+
+#endif /* _TRACE_QCOM_GPI_H */
+
+#include <trace/define_trace.h>
